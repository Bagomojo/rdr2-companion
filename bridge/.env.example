# Copy this file to .env (same folder) and fill it in. .env is never committed.

# Required: an Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: spoken lines through ElevenLabs. Without these he talks in subtitles only.
# The voice ID is any voice in your ElevenLabs library (clone your own, or pick one).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: which companion the bridge plays when you start it by hand: a folder name in
# bridge\companions (default: dave). When the mod starts the bridge, Companion= in
# KitCompanion.ini picks it instead.
# COMPANION=dave

# Optional: voice volume relative to the game, 0.0 to 1.0 (default 0.4).
# COMPANION_VOICE_VOLUME=0.4

# Optional, instead of pasting keys above: a PowerShell script that prints a secret, called as
#   powershell -File <script> -Item <item name> -Field password
# RDR2_VAULT_SCRIPT=
# RDR2_VAULT_ANTHROPIC_ITEM=Anthropic rdr2-companion
# RDR2_VAULT_ELEVENLABS_ITEM=ElevenLabs rdr2-companion
