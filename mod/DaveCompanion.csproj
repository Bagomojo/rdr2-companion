<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>DaveCompanion</AssemblyName>
    <RootNamespace>DaveCompanion</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Keep in step with bridge/version.py. -->
    <Version>0.2.1</Version>
    <!-- Where RDR2 lives; override with -p:RDR2Dir=... for another install. -->
    <RDR2Dir Condition="'$(RDR2Dir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Red Dead Redemption 2</RDR2Dir>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ships with ScriptHookRDR2DotNet V2; referenced from the game folder, never copied or committed. -->
    <Reference Include="ScriptHookRDRNetAPI">
      <HintPath>$(RDR2Dir)\ScriptHookRDRNetAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
